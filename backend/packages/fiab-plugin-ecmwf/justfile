val:
    uv run ty check src tests
    # the metadata generator builds fiab-core pydantic models, so type-check it to keep the
    # emitted artifacts.json payload in sync with the schema (see fiab_core.artifacts)
    uv run ty check scripts/get_metadata_from_anemoi.py
    just test

test:
    uv run pytest ./tests/unit && uv run --extra runtime pytest ./tests/runtime

build:
    python -m build --installer uv .
