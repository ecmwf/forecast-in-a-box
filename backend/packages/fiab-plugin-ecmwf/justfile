val:
    uv run ty check src tests
    # the metadata generator builds fiab-core pydantic models, so type-check it to keep the
    # emitted artifacts.json payload in sync with the schema (see fiab_core.artifacts)
    # NOTE the script's requirements come from its PEP 723 header, independent of the ambient venv
    uv sync -q --script scripts/get_metadata_from_anemoi.py
    uv run ty check --python "$(uv python find --script scripts/get_metadata_from_anemoi.py)" --extra-search-path src scripts/get_metadata_from_anemoi.py
    just test

test:
    #!/usr/bin/env bash
    set -euo pipefail
    uv run pytest ./tests/unit && uv run --extra runtime pytest ./tests/runtime

build:
    python -m build --installer uv .
