val:
    #!/usr/bin/env bash
    set -euo pipefail
    uv run ty check src tests
    # NOTE the metadata generator builds fiab-core pydantic models, so it is type-checked to keep the emitted
    # artifacts.json payload in sync with the schema (see fiab_core.artifacts)
    # NOTE the requirements of each script come from its PEP 723 header, independent of the ambient venv
    for script in scripts/*.py ; do
        uv sync -q --script "$script"
        uv run ty check --python "$(uv python find --script "$script")" --extra-search-path src "$script"
    done
    just test

test:
    #!/usr/bin/env bash
    set -euo pipefail
    uv run pytest ./tests/unit && uv run --extra runtime pytest ./tests/runtime

build:
    python -m build --installer uv .
