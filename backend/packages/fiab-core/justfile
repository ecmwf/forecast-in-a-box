val:
    #!/usr/bin/env bash
    set -euo pipefail
    uv run ty check src/
    if [ "${RELEASE:-}" == "1" ] ; then
        # NOTE these withs are required because during release, we do *not* use the big ambient venv
        # NOTE we cannot just `uv run --with <reqs> ty check`, because ty would not see them then
        uv pip install -r requirements.scripts.txt
        uv run ty check scripts/
        uv pip uninstall -r requirements.scripts.txt
    else
        uv run ty check scripts/
    fi
    uv run pytest tests/unit
    uv run python scripts/parse_test_artifacts_catalog.py ../../../install/artifacts.json
    uv run python scripts/run_types_conformance.py tests/conformance

build:
    python -m build --installer uv .
