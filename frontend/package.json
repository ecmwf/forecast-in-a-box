{
  "name": "frontend-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "dev:mock": "VITE_ENABLE_MOCKS=true vite --port ${VITE_PORT:-3000}",
    "build": "vite build && tsc",
    "prodbuild": "vite build && tsc",
    "serve": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:gpu": "vitest run --config vitest.gpu.config.ts",
    "test:globe": "npm run test:gpu && playwright test --project globe",
    "test:e2e:stack": "playwright test --config playwright.config.stack.ts",
    "test:clean-screenshots": "rm -rf .vitest/attachments/failure-screenshots",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "prettier --check . && eslint . --max-warnings 0 && npm run typecheck",
    "fix": "prettier --write . && eslint --fix .",
    "analyze": "vite build --mode analyze",
    "validate:fix": "npm run fix && npm run check && npm run test:run && npm run test:e2e && npm run build",
    "validate:local": "npm run fix && npm run check && npm run test:run && npm run test:gpu && VITE_PORT=${VITE_PORT:-3100} npm run test:e2e && npm run build",
    "validate:ci": "npm run check && npm run test:run && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "^3.1.2",
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/react-hotkeys": "^0.16.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/d3-polygon": "^3.0.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-polygon": "^3.0.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.5.7",
    "lucide-react": "^1.61.0",
    "lz-string": "^1.5.0",
    "maplibre-gl": "^6.15.0",
    "ol": "^10.11.0",
    "ol-mapbox-style": "^13.8.0",
    "pdfjs-dist": "^6.4.299",
    "proj4": "^2.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-globe.gl": "^2.38.0",
    "react-i18next": "^17.1.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint-plugin-license-header": "^0.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "i18next-cli": "^1.80.0",
    "msw": "^3.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "shadcn": "^4.22.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "allowScripts": {
    "@swc/core": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
